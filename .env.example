# REQUERIDO: URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=
# REQUERIDO: Anon key (o publishable key) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUERIDO: URL base de la app en producción (ej: https://utesa-rater.vercel.app)
# Se usa para validación CSRF y redirecciones seguras.
NEXT_PUBLIC_SITE_URL=
# Solo necesaria para scripts/seed*.ts — NO agregar en Vercel ni en el cliente
# SUPABASE_SERVICE_ROLE_KEY=
